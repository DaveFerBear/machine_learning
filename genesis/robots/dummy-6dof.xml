<mujoco model="shoulder_elbow_wrist_6dof_boxes">

  <compiler angle="degree" inertiafromgeom="true"/>
  <option gravity="0 0 -9.81" timestep="0.01"/>

  <default>
    <!-- Generic link style: box, colored, with density so inertiafromgeom works -->
    <default class="link">
      <geom type="box" size="0.01 0.01 0.01" density="1000" rgba="1 0.5 0 1"/>
    </default>

    <!-- End-effector marker -->
    <default class="marker">
      <geom type="sphere" size="0.02" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    </default>
  </default>

  <worldbody>
    <body name="base" pos="0 0 0">

      <!-- SHOULDER_A: twist about y, 5cm link along +x -->
      <body name="link1" pos="0 0 0">
        <joint name="SHOULDER_A" type="hinge" axis="0 1 0" range="-180 180"/>
        <!-- length 0.05 → half-length 0.025, center at (0.025, 0, 0) -->
        <geom class="link" name="link1_geom"
              type="box" size="0.025 0.01 0.01" pos="0.025 0 0"/>

        <!-- SHOULDER_B: perpendicular link, 10cm along +z -->
        <body name="link2" pos="0.05 0 0">
          <joint name="SHOULDER_B" type="hinge" axis="1 0 0" range="-90 90"/>
          <!-- length 0.10 → half-length 0.05, center at (0, 0, 0.05) -->
          <geom class="link" name="link2_geom"
                type="box" size="0.01 0.01 0.05" pos="0 0 0.05"/>

          <!-- SHOULDER_C: colinear with link2, 25cm along +z -->
          <body name="link3" pos="0 0 0.10">
            <joint name="SHOULDER_C" type="hinge" axis="0 1 0" range="-90 90"/>
            <!-- length 0.25 → half-length 0.125, center at (0, 0, 0.125) -->
            <geom class="link" name="link3_geom"
                  type="box" size="0.01 0.01 0.125" pos="0 0 0.125"/>

            <!-- ELBOW_A: perpendicular, 20cm along +x -->
            <body name="link4" pos="0 0 0.25">
              <joint name="ELBOW_A" type="hinge" axis="0 1 0" range="-135 0"/>
              <!-- length 0.20 → half-length 0.10, center at (0.10, 0, 0) -->
              <geom class="link" name="link4_geom"
                    type="box" size="0.10 0.01 0.01" pos="0.10 0 0"/>

              <!-- ELBOW_B: colinear with link4, 15cm along +x -->
              <body name="link5" pos="0.20 0 0">
                <joint name="ELBOW_B" type="hinge" axis="0 1 0" range="-90 90"/>
                <!-- length 0.15 → half-length 0.075, center at (0.075, 0, 0) -->
                <geom class="link" name="link5_geom"
                      type="box" size="0.075 0.01 0.01" pos="0.075 0 0"/>

                <!-- WRIST_A: perpendicular, 15cm along +z -->
                <body name="link6" pos="0.15 0 0">
                  <joint name="WRIST_A" type="hinge" axis="1 0 0" range="-90 90"/>
                  <!-- length 0.15 → half-length 0.075, center at (0, 0, 0.075) -->
                  <geom class="link" name="link6_geom"
                        type="box" size="0.01 0.01 0.075" pos="0 0 0.075"/>

                  <!-- "hand" / EE marker -->
                  <body name="hand" pos="0 0 0.15">
                    <geom class="marker" name="ee_marker"/>
                    <site name="ee_site" pos="0 0 0" size="0.02" rgba="1 1 1 1"/>
                  </body>

                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="SHOULDER_A_pos" joint="SHOULDER_A" kp="50"/>
    <position name="SHOULDER_B_pos" joint="SHOULDER_B" kp="50"/>
    <position name="SHOULDER_C_pos" joint="SHOULDER_C" kp="50"/>
    <position name="ELBOW_A_pos"   joint="ELBOW_A"   kp="40"/>
    <position name="ELBOW_B_pos"   joint="ELBOW_B"   kp="40"/>
    <position name="WRIST_A_pos"   joint="WRIST_A"   kp="30"/>
  </actuator>

</mujoco>
