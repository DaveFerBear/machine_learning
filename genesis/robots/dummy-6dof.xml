<mujoco model="shoulder_elbow_5dof">

  <!-- Use degrees for readability; infer inertia from geoms -->
  <compiler angle="degree" inertiafromgeom="true"/>

  <option gravity="0 0 -9.81" timestep="0.01"/>

  <default>
    <!-- Generic link style -->
    <default class="link">
      <!-- density>0 so inertiafromgeom has something to use -->
      <geom type="capsule" size="0.04" density="1000" rgba="1 0.5 0 1"/>
    </default>

    <!-- End-effector marker -->
    <default class="marker">
      <geom type="sphere" size="0.02" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    </default>
  </default>

  <worldbody>
    <body name="base" pos="0 0 0">

      <!-- Link1: SHOULDER_A (yaw) -->
      <body name="link1" pos="0 0 0">
        <joint name="SHOULDER_A" type="hinge" axis="0 0 1" range="-180 180"/>
        <!-- upper part of arm attached to base -->
        <geom class="link" name="link1_geom" fromto="0 0 0 0.2 0 0"/>

        <!-- Link2: SHOULDER_B (pitch) -->
        <body name="link2" pos="0.2 0 0">
          <joint name="SHOULDER_B" type="hinge" axis="0 1 0" range="-90 90"/>
          <geom class="link" name="link2_geom" fromto="0 0 0 0.2 0 0"/>

          <!-- Link3: SHOULDER_C (roll) -->
          <body name="link3" pos="0.2 0 0">
            <joint name="SHOULDER_C" type="hinge" axis="1 0 0" range="-90 90"/>
            <geom class="link" name="link3_geom" fromto="0 0 0 0.2 0 0"/>

            <!-- Link4: ELBOW_A (pitch) -->
            <body name="link4" pos="0.2 0 0">
              <joint name="ELBOW_A" type="hinge" axis="0 1 0" range="-135 0"/>
              <geom class="link" name="link4_geom" fromto="0 0 0 0.2 0 0"/>

              <!-- Link5: ELBOW_B (twist) -->
              <body name="link5" pos="0.2 0 0">
                <joint name="ELBOW_B" type="hinge" axis="0 0 1" range="-90 90"/>
                <geom class="link" name="link5_geom" fromto="0 0 0 0.2 0 0"/>

                <!-- "hand" / end-effector site (no gripper yet) -->
                <body name="hand" pos="0.2 0 0">
                  <geom class="marker" name="ee_marker"/>
                  <site name="ee_site" pos="0 0 0" size="0.02" rgba="1 1 1 1"/>
                </body>

              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- Position actuators (simple joint-space servos) -->
  <actuator>
    <position name="SHOULDER_A_pos" joint="SHOULDER_A" kp="50"/>
    <position name="SHOULDER_B_pos" joint="SHOULDER_B" kp="50"/>
    <position name="SHOULDER_C_pos" joint="SHOULDER_C" kp="50"/>
    <position name="ELBOW_A_pos"   joint="ELBOW_A"   kp="40"/>
    <position name="ELBOW_B_pos"   joint="ELBOW_B"   kp="40"/>
  </actuator>

</mujoco>
