<mujoco model="shoulder_elbow_wrist_6dof_capsules_mmfit">
  <compiler angle="degree" inertiafromgeom="true"/>
  <option gravity="0 0 -9.81" timestep="0.01"/>

  <default>
    <!-- Visual + inertial link: capsule between parent joint and child joint -->
    <default class="link">
      <geom type="capsule" size="0.01" density="1000" rgba="1 0.5 0 1"/>
    </default>

    <!-- End-effector marker -->
    <default class="marker">
      <geom type="sphere" size="0.02" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    </default>
  </default>

  <worldbody>
    <body name="base" pos="0 0 0">

      <!-- Joint: SHOULDER_A -->
      <body name="link1" pos="0 0 0">
        <joint name="SHOULDER_A" type="hinge" axis="1 0 0" range="-90 90"/>

        <!-- SHOULDER_A -> SHOULDER_B
             mm: [45.987, 0.001, -1.243]  => m: [0.045987, 0.000001, -0.001243] -->
        <geom class="link" name="link1_to_link2" fromto="0 0 0  0.045987 0.000001 -0.001243"/>

        <body name="link2" pos="0.045987 0.000001 -0.001243">
          <joint name="SHOULDER_B" type="hinge" axis="1 0 0" range="-90 90"/>

          <!-- SHOULDER_B -> SHOULDER_C
               mm: [6.149, -81.077, -0.017] => m: [0.006149, -0.081077, -0.000017] -->
          <geom class="link" name="link2_to_link3" fromto="0 0 0  0.006149 -0.081077 -0.000017"/>

          <body name="link3" pos="0.006149 -0.081077 -0.000017">
            <joint name="SHOULDER_C" type="hinge" axis="0 1 0" range="-90 90"/>

            <!-- SHOULDER_C -> ELBOW_A
                 mm: [188.041, 0.027, -0.274] => m: [0.188041, 0.000027, -0.000274] -->
            <geom class="link" name="link3_to_link4" fromto="0 0 0  0.188041 0.000027 -0.000274"/>

            <body name="link4" pos="0.188041 0.000027 -0.000274">
              <joint name="ELBOW_A" type="hinge" axis="0 1 0" range="-135 0"/>

              <!-- ELBOW_A -> ELBOW_B
                   mm: [-0.276, -99.921, -0.012] => m: [-0.000276, -0.099921, -0.000012] -->
              <geom class="link" name="link4_to_link5" fromto="0 0 0  -0.000276 -0.099921 -0.000012"/>

              <body name="link5" pos="-0.000276 -0.099921 -0.000012">
                <joint name="ELBOW_B" type="hinge" axis="0 1 0" range="-90 90"/>

                <!-- ELBOW_B -> WRIST_A
                     mm: [88.415, 0.167, 0.717] => m: [0.088415, 0.000167, 0.000717] -->
                <geom class="link" name="link5_to_link6" fromto="0 0 0  0.088415 0.000167 0.000717"/>

                <body name="link6" pos="0.088415 0.000167 0.000717">
                  <joint name="WRIST_A" type="hinge" axis="1 0 0" range="-90 90"/>

                  <!-- EE marker at WRIST_A (since we excluded WRIST_B / fingers) -->
                  <body name="hand" pos="0 0 0">
                    <geom class="marker" name="ee_marker"/>
                    <site name="ee_site" pos="0 0 0" size="0.02" rgba="1 1 1 1"/>
                  </body>

                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="SHOULDER_A_pos" joint="SHOULDER_A" kp="50"/>
    <position name="SHOULDER_B_pos" joint="SHOULDER_B" kp="50"/>
    <position name="SHOULDER_C_pos" joint="SHOULDER_C" kp="50"/>
    <position name="ELBOW_A_pos"   joint="ELBOW_A"   kp="40"/>
    <position name="ELBOW_B_pos"   joint="ELBOW_B"   kp="40"/>
    <position name="WRIST_A_pos"   joint="WRIST_A"   kp="30"/>
  </actuator>
</mujoco>
